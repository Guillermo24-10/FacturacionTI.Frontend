@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <!-- Barra Superior -->
    <Appbar OnMenuToggle="@ToggleDrawer" />

    <!-- Menú Lateral -->
    <Drawer IsOpen="@_drawerOpen" />

    <!-- Contenido Principal -->
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4 px-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void Logout()
    {
        // Implementar logout
        NavigationManager.NavigateTo("/logout", true);
    }

    [Inject] private NavigationManager NavigationManager { get; set; } = null!;
}