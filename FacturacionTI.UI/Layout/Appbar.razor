<!-- Barra Superior -->
<MudAppBar Elevation="1">
    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                   Color="Color.Inherit"
                   Edge="Edge.Start"
                   OnClick="@OnMenuToggle" />  <!-- ⭐ Llama al callback -->
    <MudText Typo="Typo.h6">Sistema de Facturación</MudText>
    <MudSpacer />

    <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" />

    <!-- Menú de Usuario -->
    <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit">
        <MudMenuItem Icon="@Icons.Material.Filled.Person">Mi Perfil</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.Settings">Configuración</MudMenuItem>
        <MudDivider />
        <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Cerrar Sesión</MudMenuItem>
    </MudMenu>
</MudAppBar>

@code {
    [Parameter] public EventCallback OnMenuToggle { get; set; }  // ⭐ Parámetro

    [Inject] private NavigationManager Navigation { get; set; } = null!;
    [Inject] private IAuthService AuthService { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private async Task Logout()
    {
        await AuthService.Logout();
        Snackbar.Add("Sesión cerrada", Severity.Info);
        Navigation.NavigateTo("/login", true);
    }
}