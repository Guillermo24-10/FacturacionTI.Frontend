@page "/reset-password"
@layout EmptyLayout

@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 100vh;">
    <MudPaper Elevation="8" Class="pa-8" Style="width: 100%; max-width: 450px;">
        <MudStack Spacing="2" AlignItems="AlignItems.Center" Class="mb-8">
            <MudIcon Icon="@Icons.Material.Filled.Book" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h4" Align="Align.Center">Restablecer contraseña</MudText>
        </MudStack>

        <EditForm Model="@resetPasswordRequest" OnValidSubmit="HandleResetPassword">
            <DataAnnotationsValidator />

            <MudStack Spacing="1">
                <MudTextField @bind-Value="resetPasswordRequest.NewPassword"
                              Label="Nueva contraseña"
                              Variant="Variant.Outlined"                              
                              InputType="PasswordInput"
                              For="@(() => resetPasswordRequest.NewPassword)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@PasswordInputIcon"
                              OnAdornmentClick="ButtonViewPasswordclick"
                              AdornmentAriaLabel="Show Password" />
            </MudStack>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Class="mt-6">
                Restablecer contraseña
            </MudButton>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private ResetPasswordRequest resetPasswordRequest = new();
    bool isShow;
    InputType PasswordInput = InputType.Password;
    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    private async Task HandleResetPassword()
    {
        var response = await AuthService.ResetPassword(resetPasswordRequest);

        if (!string.IsNullOrWhiteSpace(response))
        {
            Snackbar.Add("Contraseña restablecida con éxito. Ahora puede iniciar sesión con su nueva contraseña.", Severity.Success);
            Navigation.NavigateTo("/login");
        }
        else
        {
            Snackbar.Add(response, Severity.Error);
        }
    }

    void ButtonViewPasswordclick()
    {
        @if (isShow)
        {
            isShow = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else
        {
            isShow = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
    }
}
