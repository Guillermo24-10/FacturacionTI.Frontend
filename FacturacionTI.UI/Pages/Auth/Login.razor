@page "/login"
@layout EmptyLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 100vh;">
    <MudPaper Elevation="8" Class="pa-8" Style="width: 100%; max-width: 450px;">

        <!-- Título -->
        <MudStack Spacing="2" AlignItems="AlignItems.Center" Class="mb-8">
            <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h4" Align="Align.Center">Sistema de Facturación</MudText>
        </MudStack>

        <!-- Formulario -->
        <EditForm Model="@loginRequest" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <MudStack Spacing="4">
                <!-- RUC -->
                <MudTextField @bind-Value="loginRequest.Ruc"
                              Label="RUC"
                              Variant="Variant.Outlined"
                              For="@(() => loginRequest.Ruc)"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Business" />

                <!-- Usuario -->
                <MudTextField @bind-Value="loginRequest.UserName"
                              Label="Usuario"
                              Variant="Variant.Outlined"
                              For="@(() => loginRequest.UserName)"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person" />

                <!-- Contraseña -->
                <MudTextField @bind-Value="loginRequest.Password"
                              Label="Contraseña"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              For="@(() => loginRequest.Password)"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock" />

                <!-- Recordarme y Olvidaste contraseña -->
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudCheckBox @bind-Value="loginRequest.Recordarme"
                                 Label="Recordarme"
                                 Color="Color.Primary"
                                 Dense="true" />
                    <MudLink Href="/forgot-password" Color="Color.Primary" Typo="Typo.body2">
                        ¿Olvidaste tu contraseña?
                    </MudLink>
                </MudStack>

                <!-- Botón -->
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="@cargando">
                    @if (cargando)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Ingresando...</span>
                    }
                    else
                    {
                        <span>Iniciar Sesión</span>
                    }
                </MudButton>
            </MudStack>

        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private LoginRequest loginRequest = new();
    private bool cargando = false;

    private async Task HandleLogin()
    {
        cargando = true;

        var resultado = await AuthService.Login(loginRequest);

        if (resultado != null)
        {
            Snackbar.Add($"Bienvenido!", Severity.Success);
            Navigation.NavigateTo("/"); // Redirige al dashboard
        }
        else
        {
            Snackbar.Add("Credenciales incorrectas", Severity.Error);
        }

        cargando = false;
    }
}